{
  "name": "ecostride-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0",
    "dev:remote": "wrangler dev --remote --ip 0.0.0.0",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute ecostride-db --local --file=./schema.sql",
    "db:push": "wrangler d1 execute ecostride-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.1",
    "jose": "^5.9.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.76.0"
  }
}
